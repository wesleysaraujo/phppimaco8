{
    "name": "wesleysaraujo/phppimaco8",
    "version": "3.0.0",
    "description": "Lib para geração de Etiquetas PIMACO ( LIB do Diogo Bemfica refatorada para PHP 8 por Wesley Serafim)",
    "type": "library",
    "keywords": [
        "PIMACO",
        "etiquetas",
        "tags",
        "hang tags",
        "labels",
        "pdf",
        "barcode",
        "qrcode"
    ],
    "homepage": "https://github.com/wesleysaraujo/phppimaco8",
    "license": "MIT",
    "authors": [
        {
            "name": "Diogo Bemfica",
            "email": "diogo.fragabemfica@gmail.com"
        },
        {
            "name": "Wesley Serafim",
            "email": "wesleyserafimdev@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/wesleysaraujo/phppimaco8/issues",
        "source": "https://github.com/wesleysaraujo/phppimaco8"
    },
    "autoload": {
        "psr-4": {
            "Proner\\PhpPimaco\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "mpdf/mpdf": "^8.2",
        "endroid/qr-code": "^5.0",
        "picqer/php-barcode-generator": "^2.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Proner\\PhpPimacoTest\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    }
}